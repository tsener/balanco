{
  "listen": "0.0.0.0:8443",
  "workers": 2,
  "control_socket": "/run/balanco/control.sock",
  "drain_timeout_ms": 30000,
  "ingress": { "namespace": "balanco-ingress", "class": "balanco" },
  "tls": {
    "cert": "/etc/balanco/tls/tls.crt",
    "key": "/etc/balanco/tls/tls.key",
    "client_ca": "/etc/balanco/tls/client-ca.crt",
    "key_exchange": "hybrid_preferred"
  },
  "http1": {
    "rules": [
      { "phase": "request", "action": { "op": "set", "name": "x-forwarded-for", "value": "${client_ip}" } },
      { "phase": "request", "action": { "op": "set", "name": "x-forwarded-proto", "value": "${scheme}" } },
      { "phase": "response", "action": { "op": "remove", "name": "server" } }
    ]
  }
}
