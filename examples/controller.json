{
  "management": {
    "url": "https://localhost:9443",
    "ca": "ca.pem",
    "cert": "operator.pem",
    "key": "operator.key"
  },
  "model": { "url": "http://127.0.0.1:8772" },
  "interval_ms": 5000,
  "timeout_ms": 1000,
  "ttl_ms": 30000,
  "on_expiry": "reject",
  "confirmations": 2,
  "policies": {
    "balanced": {
      "description": "Both backends are healthy; distribute new connections evenly.",
      "profiles": { "default": { "weights": { "127.0.0.1:9001": 1, "127.0.0.1:9002": 1 } } }
    },
    "prefer-first": {
      "description": "The first backend has more spare capacity; favor it for new connections.",
      "profiles": { "default": { "weights": { "127.0.0.1:9001": 3, "127.0.0.1:9002": 1 } } }
    }
  }
}
