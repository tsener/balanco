{
  "listen": "127.0.0.1:8443",
  "workers": 2,
  "tls": {
    "cert": "/etc/balanco/tls/server-chain.pem",
    "key": "/etc/balanco/tls/server.key",
    "client_ca": "/etc/balanco/tls/device-ca.pem"
  },
  "upstream_tls": {
    "ca": "/etc/balanco/tls/backend-ca.pem",
    "cert": "/etc/balanco/tls/proxy-client-chain.pem",
    "key": "/etc/balanco/tls/proxy-client.key"
  },
  "backends": [
    { "address": "127.0.0.1:9443", "server_name": "backend.example.internal", "weight": 3 },
    { "address": "127.0.0.1:9444", "server_name": "backend.example.internal", "weight": 1 }
  ]
}
